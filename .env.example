# Copie para .env (gitignored) e preencha. Nenhum valor real entra neste arquivo.

# Token do Claude Code headless usado pelo runner (plan §4, §11).
# Gerado no host com: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Postgres de desenvolvimento (compose.yaml, plan F0). O compose sobe com usuário, senha e
# banco "banca" — senha pública de dev, não é segredo. O valor local é:
#   postgresql://banca:banca@localhost:5432/banca
DATABASE_URL=

# Diretório das skills corrige-*, FORA desta árvore e com versionamento próprio (plan §4).
# O Job Controller monta $SKILLS_DIR/<skill_slug> como :ro em /workspace/skill no runner (plan §8).
SKILLS_DIR=/home/pierry/fullcycle/.claude/skills

# Raiz dos diretórios de job: um subdiretório por correção, com prompt.txt, clone,
# transcript.jsonl e dossie.json. Retenção definida no plan §11.
JOBS_DIR=/home/pierry/banca-jobs

# Imagem do runner construída a partir de runner/Dockerfile (plan §8).
RUNNER_IMAGE=banca-runner:dev
