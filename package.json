{
  "name": "correcao-automatica",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm --filter @banca/api run db:generate",
    "db:generate": "pnpm --filter @banca/api run db:generate",
    "db:migrate": "pnpm --filter @banca/api run db:migrate",
    "db:seed": "pnpm --filter @banca/api run db:seed",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guards": "bash scripts/hooks/selftest.sh"
  },
  "devDependencies": {
    "@banca/shared": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
